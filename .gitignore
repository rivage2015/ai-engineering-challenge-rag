# Deny by default. This repository stores only reusable implementation files.
*

!.gitignore
!README.md

!design/
!design/**

!schemas/
!schemas/**

!scripts/
!scripts/*.py
!scripts/*.swift

!tests/
!tests/*.py

# Reusable end-to-end runner. Runtime caches, answers, logs, assets and secrets
# remain denied by the default rule above.
!rag/
rag/*
!rag/*.py
!rag/requirements.txt

!実行.command

# Reproducible macOS distribution source only. Built DMG/ZIP files, local
# indexes, models, user documents and logs remain excluded.
!distribution/
distribution/*
!distribution/macos-local-memory/
!distribution/macos-local-memory/**

**/__pycache__/
**/*.py[cod]
**/.DS_Store
