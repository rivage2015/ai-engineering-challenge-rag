{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-engineering-challenge/schemas/data-catalog-entry.schema.json",
  "title": "DataCatalogEntry",
  "description": "Question-independent, value-free metadata for one retrieval-addressable source container. The deterministic entry ID is derived from semantic source metadata and excludes generated_at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "data_catalog_entry_id",
    "document_id",
    "source_identity",
    "address",
    "scope_labels",
    "fields",
    "capabilities",
    "availability",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "data_catalog_entry"},
    "data_catalog_entry_id": {"$ref": "#/$defs/entryId"},
    "document_id": {"$ref": "#/$defs/documentId"},
    "source_identity": {"$ref": "#/$defs/sourceIdentity"},
    "address": {"$ref": "#/$defs/address"},
    "scope_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scopeLabel"}
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field"}
    },
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "availability": {"$ref": "#/$defs/availability"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "entryId": {
      "type": "string",
      "pattern": "^dce_[0-9a-f]{16,64}$"
    },
    "labelId": {
      "type": "string",
      "pattern": "^dcl_[0-9a-f]{16,64}$"
    },
    "fieldId": {
      "type": "string",
      "pattern": "^dcf_[0-9a-f]{16,64}$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{16,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableText": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "sourceRef": {
      "oneOf": [
        {"type": "string", "pattern": "^doc_[0-9a-f]{16,64}$"},
        {"type": "string", "pattern": "^ev_[0-9a-f]{16,64}$"},
        {"type": "string", "pattern": "^su_[0-9a-f]{16,64}$"}
      ]
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "file_name",
        "extension",
        "media_type",
        "sha256"
      ],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "file_name": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "pattern": "^[a-z0-9]*$"},
        "media_type": {
          "type": "string",
          "pattern": "^[^\\s/]+/[^\\s/]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_kind",
        "container_name",
        "container_index",
        "source_member",
        "parent_entry_ref"
      ],
      "properties": {
        "container_kind": {
          "enum": [
            "document",
            "worksheet",
            "table",
            "page",
            "slide",
            "archive_member"
          ]
        },
        "container_name": {"$ref": "#/$defs/nullableText"},
        "container_index": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_member": {"$ref": "#/$defs/nullableText"},
        "parent_entry_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/entryId"}
          ]
        }
      }
    },
    "scopeLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_id",
        "role",
        "surface",
        "normalized",
        "source_kind",
        "source_refs"
      ],
      "properties": {
        "label_id": {"$ref": "#/$defs/labelId"},
        "role": {"enum": ["location", "container"]},
        "surface": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1},
        "source_kind": {
          "enum": [
            "path_component",
            "file_name",
            "file_stem",
            "worksheet_name",
            "table_name",
            "declared_metadata"
          ]
        },
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "surface",
        "normalized",
        "ordinal",
        "data_type",
        "unit",
        "source_refs"
      ],
      "properties": {
        "field_id": {"$ref": "#/$defs/fieldId"},
        "surface": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1},
        "ordinal": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "data_type": {
          "enum": [
            "unknown",
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime"
          ]
        },
        "unit": {"$ref": "#/$defs/nullableText"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_channels",
        "predicate_operators",
        "graph_operators"
      ],
      "properties": {
        "retrieval_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "lexical",
              "semantic",
              "structured",
              "relation_traversal"
            ]
          }
        },
        "predicate_operators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "eq",
              "ne",
              "gt",
              "gte",
              "lt",
              "lte",
              "in",
              "not_in",
              "contains",
              "starts_with",
              "ends_with",
              "matches",
              "between",
              "is_null",
              "is_not_null"
            ]
          }
        },
        "graph_operators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "filter",
              "project",
              "count",
              "list",
              "retrieve",
              "compare",
              "calculate",
              "sum",
              "mean",
              "min",
              "max",
              "absolute_distance",
              "argmin_all",
              "argmax_all",
              "sort",
              "deduplicate",
              "group",
              "explain",
              "procedure",
              "verify",
              "boolean_test"
            ]
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_status", "searchable", "reason_codes"],
      "properties": {
        "extraction_status": {
          "enum": ["pending", "success", "partial", "deferred", "failed"]
        },
        "searchable": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "extraction_pending",
              "extraction_partial",
              "extraction_deferred",
              "extraction_failed",
              "no_searchable_content",
              "unsupported_container",
              "unsupported_schema"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder",
        "builder_version",
        "generated_at",
        "deterministic",
        "question_independent",
        "source_data_used",
        "question_data_used",
        "answer_data_used",
        "past_answers_used",
        "raw_values_embedded",
        "input_refs"
      ],
      "properties": {
        "builder": {"const": "data-catalog-builder"},
        "builder_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "deterministic": {"const": true},
        "question_independent": {"const": true},
        "source_data_used": {"const": true},
        "question_data_used": {"const": false},
        "answer_data_used": {"const": false},
        "past_answers_used": {"const": false},
        "raw_values_embedded": {"const": false},
        "input_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "properties": {"searchable": {"const": true}},
            "required": ["searchable"]
          }
        },
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "retrieval_channels": {"minItems": 1}
            }
          },
          "availability": {
            "properties": {
              "extraction_status": {"enum": ["success", "partial"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "properties": {"searchable": {"const": false}},
            "required": ["searchable"]
          }
        },
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "retrieval_channels": {"maxItems": 0},
              "predicate_operators": {"maxItems": 0},
              "graph_operators": {"maxItems": 0}
            }
          },
          "availability": {
            "properties": {"reason_codes": {"minItems": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "properties": {
              "extraction_status": {
                "enum": ["pending", "deferred", "failed"]
              }
            },
            "required": ["extraction_status"]
          }
        },
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "availability": {
            "properties": {"searchable": {"const": false}}
          }
        }
      }
    }
  ]
}
