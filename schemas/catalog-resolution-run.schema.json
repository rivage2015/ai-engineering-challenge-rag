{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-engineering-challenge/schemas/catalog-resolution-run.schema.json",
  "title": "CatalogResolutionRun",
  "description": "Deterministic Phase 2.5 record that binds question-intent branches to value-free Data Catalog metadata before retrieval. This closed record intentionally has no original-question text, filter or answer values, relevance scores, ranking, or primary-result field. A later semantic validator must verify hashes, IDs, references, catalog membership, branch coverage, and actual QIC path bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "catalog_resolution_run_id",
    "question_understanding_run_id",
    "question_intent_contract_id",
    "question_clause_ir_id",
    "data_catalog_snapshot_id",
    "branch_resolutions",
    "final_status",
    "reason_codes",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "catalog_resolution_run"},
    "catalog_resolution_run_id": {"$ref": "#/$defs/runId"},
    "question_understanding_run_id": {"$ref": "#/$defs/questionRunId"},
    "question_intent_contract_id": {"$ref": "#/$defs/intentContractId"},
    "question_clause_ir_id": {"$ref": "#/$defs/clauseIrId"},
    "data_catalog_snapshot_id": {"$ref": "#/$defs/catalogSnapshotId"},
    "branch_resolutions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/branchResolution"}
    },
    "final_status": {
      "enum": [
        "resolved",
        "clarification_required",
        "abstained",
        "failed"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reasonCode"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/errorRecord"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"final_status": {"const": "resolved"}},
        "required": ["final_status"]
      },
      "then": {
        "properties": {
          "branch_resolutions": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": {"status": {"const": "resolved"}}
            }
          },
          "reason_codes": {"maxItems": 0},
          "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_status": {
            "enum": ["clarification_required", "abstained"]
          }
        },
        "required": ["final_status"]
      },
      "then": {
        "properties": {
          "reason_codes": {"minItems": 1},
          "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"final_status": {"const": "failed"}},
        "required": ["final_status"]
      },
      "then": {
        "properties": {"errors": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^crr_[0-9a-f]{16,64}$"
    },
    "questionRunId": {
      "type": "string",
      "pattern": "^qur_[0-9a-f]{16,64}$"
    },
    "intentContractId": {
      "type": "string",
      "pattern": "^qic_[0-9a-f]{16,64}$"
    },
    "clauseIrId": {
      "type": "string",
      "pattern": "^qcir_[0-9a-f]{16,64}$"
    },
    "catalogSnapshotId": {
      "type": "string",
      "pattern": "^dcs_[0-9a-f]{16,64}$"
    },
    "catalogEntryId": {
      "type": "string",
      "pattern": "^dce_[0-9a-f]{16,64}$"
    },
    "catalogLabelId": {
      "type": "string",
      "pattern": "^dcl_[0-9a-f]{16,64}$"
    },
    "catalogFieldId": {
      "type": "string",
      "pattern": "^dcf_[0-9a-f]{16,64}$"
    },
    "branchId": {
      "type": "string",
      "pattern": "^branch_[0-9a-f]{16,64}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^crb_[0-9a-f]{16,64}$"
    },
    "operationId": {
      "type": "string",
      "description": "OperationGraph operation_id; matches the QuestionIntentContract identifier contract.",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qicPath": {
      "type": "string",
      "description": "Non-root pointer into an intent-bearing QIC domain; existence and binding are checked semantically.",
      "pattern": "^(?:/requested/(?:target|scope|operation_graph|requested_outputs)(?:/(?:[^~/]|~[01])+)*|/not_requested/(?:0|[1-9][0-9]*)(?:/(?:[^~/]|~[01])+)*|/ambiguity/(?:0|[1-9][0-9]*)(?:/(?:[^~/]|~[01])+)*)$"
    },
    "basisRef": {
      "oneOf": [
        {"type": "string", "pattern": "^qcl_[0-9a-f]{16,64}$"},
        {"$ref": "#/$defs/catalogLabelId"},
        {"$ref": "#/$defs/catalogFieldId"},
        {"$ref": "#/$defs/catalogEntryId"},
        {"type": "string", "pattern": "^doc_[0-9a-f]{16,64}$"},
        {"type": "string", "pattern": "^ev_[0-9a-f]{16,64}$"},
        {"type": "string", "pattern": "^su_[0-9a-f]{16,64}$"}
      ]
    },
    "basisRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/basisRef"}
    },
    "scopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qic_path", "label_ref", "match_mode", "status"],
      "properties": {
        "qic_path": {"$ref": "#/$defs/qicPath"},
        "label_ref": {"$ref": "#/$defs/catalogLabelId"},
        "match_mode": {"enum": ["exact", "exact_normalized"]},
        "status": {"enum": ["matched", "conflict"]}
      }
    },
    "fieldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qic_path", "field_ref", "match_mode", "status"],
      "properties": {
        "qic_path": {"$ref": "#/$defs/qicPath"},
        "field_ref": {"$ref": "#/$defs/catalogFieldId"},
        "match_mode": {"enum": ["exact", "exact_normalized"]},
        "status": {"enum": ["matched", "conflict"]}
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qic_path", "target_kind", "target_ref", "match_mode", "status"],
      "properties": {
        "qic_path": {
          "type": "string",
          "pattern": "^/requested/target(?:/(?:[^~/]|~[01])+)*$"
        },
        "target_kind": {"enum": ["catalog_entry", "field"]},
        "target_ref": {
          "oneOf": [
            {"$ref": "#/$defs/catalogEntryId"},
            {"$ref": "#/$defs/catalogFieldId"}
          ]
        },
        "match_mode": {"enum": ["exact", "exact_normalized"]},
        "status": {"enum": ["matched", "conflict"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"target_kind": {"const": "catalog_entry"}},
            "required": ["target_kind"]
          },
          "then": {
            "properties": {"target_ref": {"$ref": "#/$defs/catalogEntryId"}}
          }
        },
        {
          "if": {
            "properties": {"target_kind": {"const": "field"}},
            "required": ["target_kind"]
          },
          "then": {
            "properties": {"target_ref": {"$ref": "#/$defs/catalogFieldId"}}
          }
        }
      ]
    },
    "retrievalCapability": {
      "enum": ["lexical", "semantic", "structured", "relation_traversal"]
    },
    "predicateCapability": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte",
        "in",
        "not_in",
        "contains",
        "starts_with",
        "ends_with",
        "matches",
        "between",
        "is_null",
        "is_not_null"
      ]
    },
    "graphCapability": {
      "enum": [
        "filter",
        "project",
        "count",
        "list",
        "retrieve",
        "compare",
        "calculate",
        "sum",
        "mean",
        "min",
        "max",
        "absolute_distance",
        "argmin_all",
        "argmax_all",
        "sort",
        "deduplicate",
        "group",
        "explain",
        "procedure",
        "verify",
        "boolean_test"
      ]
    },
    "requiredCapability": {
      "oneOf": [
        {"$ref": "#/$defs/retrievalCapability"},
        {"$ref": "#/$defs/predicateCapability"},
        {"$ref": "#/$defs/graphCapability"}
      ]
    },
    "capabilityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_ref",
        "capability_kind",
        "required_capability",
        "status",
        "reason_code"
      ],
      "properties": {
        "operation_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/operationId"}
          ]
        },
        "capability_kind": {
          "enum": [
            "retrieval_channel",
            "predicate_operator",
            "graph_operator"
          ]
        },
        "required_capability": {"$ref": "#/$defs/requiredCapability"},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "reason_code": {
          "enum": [
            null,
            "declared_supported",
            "not_declared",
            "catalog_unavailable",
            "operation_unresolved"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_kind": {"const": "retrieval_channel"}
            },
            "required": ["capability_kind"]
          },
          "then": {
            "properties": {
              "operation_ref": {"const": null},
              "required_capability": {"$ref": "#/$defs/retrievalCapability"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_kind": {"const": "predicate_operator"}
            },
            "required": ["capability_kind"]
          },
          "then": {
            "properties": {
              "operation_ref": {"$ref": "#/$defs/operationId"},
              "required_capability": {"$ref": "#/$defs/predicateCapability"}
            }
          }
        },
        {
          "if": {
            "properties": {"capability_kind": {"const": "graph_operator"}},
            "required": ["capability_kind"]
          },
          "then": {
            "properties": {
              "operation_ref": {"$ref": "#/$defs/operationId"},
              "required_capability": {"$ref": "#/$defs/graphCapability"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "pass"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason_code": {"enum": [null, "declared_supported"]}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"enum": ["fail", "unknown"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "not_declared",
                  "catalog_unavailable",
                  "operation_unresolved"
                ]
              }
            }
          }
        }
      ]
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "catalog_entry_ref",
        "target_bindings",
        "scope_bindings",
        "field_bindings",
        "capability_checks",
        "basis_refs",
        "status"
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/bindingId"},
        "catalog_entry_ref": {"$ref": "#/$defs/catalogEntryId"},
        "target_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetBinding"}
        },
        "scope_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scopeBinding"}
        },
        "field_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldBinding"}
        },
        "capability_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capabilityCheck"}
        },
        "basis_refs": {"$ref": "#/$defs/basisRefs"},
        "status": {"enum": ["resolved", "partial", "conflict"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "resolved"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "target_bindings": {
                "minItems": 1,
                "items": {"properties": {"status": {"const": "matched"}}}
              },
              "scope_bindings": {
                "items": {"properties": {"status": {"const": "matched"}}}
              },
              "field_bindings": {
                "items": {"properties": {"status": {"const": "matched"}}}
              },
              "capability_checks": {
                "minItems": 1,
                "items": {"properties": {"status": {"const": "pass"}}}
              }
            }
          }
        }
      ]
    },
    "branchResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "candidate_bindings", "status"],
      "properties": {
        "branch_id": {"$ref": "#/$defs/branchId"},
        "candidate_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidateBinding"}
        },
        "status": {
          "enum": ["resolved", "ambiguous", "missing", "unsupported", "conflict"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "resolved"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "candidate_bindings": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {"status": {"const": "resolved"}}
                }
              }
            }
          }
        }
      ]
    },
    "reasonCode": {
      "enum": [
        "intent_not_ready",
        "clause_coverage_incomplete",
        "catalog_missing",
        "scope_missing",
        "scope_ambiguous",
        "field_missing",
        "field_ambiguous",
        "capability_unsupported",
        "binding_conflict",
        "branch_limit_exceeded",
        "validation_failed",
        "runtime_failure"
      ]
    },
    "subjectRef": {
      "description": "A subject reference may match both the generic QIC operation identifier and a typed record ID; semantic validation resolves it against the actual input records.",
      "anyOf": [
        {"$ref": "#/$defs/runId"},
        {"$ref": "#/$defs/questionRunId"},
        {"$ref": "#/$defs/intentContractId"},
        {"$ref": "#/$defs/clauseIrId"},
        {"$ref": "#/$defs/catalogSnapshotId"},
        {"$ref": "#/$defs/branchId"},
        {"$ref": "#/$defs/bindingId"},
        {"$ref": "#/$defs/operationId"},
        {"$ref": "#/$defs/basisRef"}
      ]
    },
    "errorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "subject_refs"],
      "properties": {
        "stage": {
          "enum": [
            "load",
            "intent",
            "catalog",
            "resolution",
            "validation",
            "runtime"
          ]
        },
        "code": {
          "enum": [
            "input_invalid",
            "intent_invalid",
            "catalog_invalid",
            "resolution_failed",
            "validation_failed",
            "internal_error"
          ]
        },
        "subject_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/subjectRef"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolver",
        "resolver_version",
        "generated_at",
        "deterministic",
        "model_used",
        "question_independent",
        "question_data_used",
        "source_data_used",
        "answer_data_used",
        "past_answers_used",
        "input_qur_sha256",
        "input_catalog_sha256"
      ],
      "properties": {
        "resolver": {"const": "catalog-resolver"},
        "resolver_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "deterministic": {"const": true},
        "model_used": {"const": false},
        "question_independent": {"const": false},
        "question_data_used": {"const": true},
        "source_data_used": {"const": true},
        "answer_data_used": {"const": false},
        "past_answers_used": {"const": false},
        "input_qur_sha256": {"$ref": "#/$defs/sha256"},
        "input_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
