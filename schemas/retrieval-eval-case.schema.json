{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-engineering-challenge/schemas/retrieval-eval-case.schema.json",
  "title": "RetrievalEvalCase",
  "description": "検索完了後にだけ正解集合と照合する評価ケース",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "eval_case_id",
    "query",
    "relevant_search_unit_ids",
    "category",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "retrieval_eval_case"},
    "eval_case_id": {"type": "string", "pattern": "^qe_[0-9a-f]{16,64}$"},
    "query": {"type": "string", "minLength": 1},
    "relevant_search_unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^su_[0-9a-f]{16,64}$"}
    },
    "category": {
      "enum": ["paragraph_chunk", "table_row", "slide_text", "page_text", "cross_format", "other"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "generator", "generator_version", "deterministic"],
      "properties": {
        "method": {"enum": ["self_retrieval", "human_reviewed"]},
        "generator": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "deterministic": {"type": "boolean"},
        "source_search_unit_id": {"type": "string", "pattern": "^su_[0-9a-f]{16,64}$"}
      }
    }
  }
}
