{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-engineering-challenge/schemas/document.schema.json",
  "title": "Document",
  "description": "原本ファイルと抽出処理の管理情報",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "document_id",
    "source",
    "extraction"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "document"},
    "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16,64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "file_name",
        "extension",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "file_name": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "pattern": "^[a-z0-9]*$"},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modified_at": {"type": "string", "format": "date-time"},
        "archive_relative_path": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/derivedString"},
        "document_role": {"$ref": "#/$defs/derivedString"},
        "version_group": {"$ref": "#/$defs/derivedString"},
        "version_label": {"$ref": "#/$defs/derivedString"}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parser", "parser_version", "extracted_at"],
      "properties": {
        "status": {
          "enum": ["pending", "success", "partial", "deferred", "failed"]
        },
        "parser": {"type": "string", "minLength": 1},
        "parser_version": {"type": "string", "minLength": 1},
        "extracted_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "warnings": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "errors": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "derivedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "method", "confidence"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
