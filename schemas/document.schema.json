{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-engineering-challenge/schemas/document.schema.json",
  "title": "Document",
  "description": "原本ファイルと抽出処理の管理情報",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "document_id",
    "source",
    "extraction"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "document"},
    "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16,64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "file_name",
        "extension",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "file_name": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "pattern": "^[a-z0-9]*$"},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modified_at": {"type": "string", "format": "date-time"},
        "archive_relative_path": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/derivedString"},
        "document_role": {"$ref": "#/$defs/derivedString"},
        "version_group": {"$ref": "#/$defs/derivedString"},
        "version_label": {"$ref": "#/$defs/derivedString"}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parser", "parser_version", "extracted_at"],
      "properties": {
        "status": {
          "enum": ["pending", "success", "partial", "deferred", "failed"]
        },
        "parser": {"type": "string", "minLength": 1},
        "parser_version": {"type": "string", "minLength": 1},
        "extracted_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "warnings": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "errors": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "reading_policy": {"const": "text_first_v1"},
        "visual_coverage": {"$ref": "#/$defs/visualCoverage"}
      },
      "dependentRequired": {
        "reading_policy": ["visual_coverage"],
        "visual_coverage": ["reading_policy"]
      },
      "allOf": [{
        "if": {
          "required": ["visual_coverage"],
          "properties": {"visual_coverage": {
            "required": ["status"],
            "properties": {"status": {"const": "pending"}}
          }}
        },
        "then": {"properties": {"status": {"enum": ["partial", "failed"]}}}
      }]
    }
  },
  "$defs": {
    "visualCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pending"],
      "properties": {
        "status": {"enum": ["pending", "none_pending"]},
        "pending": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pendingVisual"}
        }
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "pending"}}},
        "then": {"properties": {"pending": {"minItems": 1}}},
        "else": {"properties": {"pending": {"maxItems": 0}}}
      }]
    },
    "pendingVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_sha256", "location", "reason", "kind"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev_[0-9a-f]{16,64}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "location": {"$ref": "#/$defs/visualLocation"},
        "reason": {"const": "deferred_by_reading_policy"},
        "kind": {"enum": ["embedded_image", "pdf_page", "standalone_image"]}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "pdf_page"}}},
        "then": {"not": {"required": ["image_sha256"]}},
        "else": {"required": ["image_sha256"]}
      }]
    },
    "visualLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_number": {"type": "integer", "minimum": 1},
        "slide_number": {"type": "integer", "minimum": 1},
        "sheet_name": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"},
        "range": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "paragraph_index": {"type": "integer", "minimum": 1},
        "table_index": {"type": "integer", "minimum": 1},
        "row_index": {"type": "integer", "minimum": 1},
        "column_index": {"type": "integer", "minimum": 1},
        "shape_id": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "object_index": {"type": "integer", "minimum": 1},
        "image_object_index": {"type": "integer", "minimum": 1},
        "series_index": {"type": "integer", "minimum": 1},
        "notebook_cell_index": {"type": "integer", "minimum": 1},
        "code_line_start": {"type": "integer", "minimum": 1},
        "code_line_end": {"type": "integer", "minimum": 1},
        "source_member": {"type": "string", "minLength": 1},
        "locator_text": {"type": "string", "minLength": 1}
      }
    },
    "derivedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "method", "confidence"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
