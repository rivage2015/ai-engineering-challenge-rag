{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-engineering-challenge/schemas/visual-table-observation.schema.json",
  "title": "VisualTableObservation",
  "description": "Question-independent shadow observation of one visual table. Raw OCR text is never corrected by this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "observation_id", "runner_version", "source", "upstream", "status", "reasons", "table", "hashes", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "visual_table_observation"},
    "observation_id": {"type": "string", "pattern": "^vtobs_[0-9a-f]{24}$"},
    "runner_version": {"const": "0.1"},
    "source": {"$ref": "#/$defs/source"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "status": {"enum": ["pass", "hold"]},
    "reasons": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}},
    "table": {"$ref": "#/$defs/table"},
    "hashes": {"$ref": "#/$defs/hashes"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {"properties": {"reasons": {"maxItems": 0}}},
      "else": {"properties": {"reasons": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"table": {"properties": {"structure_status": {"const": "pass"}}, "required": ["structure_status"]}}},
      "then": {"properties": {"table": {"properties": {"coverage": {"properties": {"coverage_ratio": {"const": 1.0}, "missing_slots": {"maxItems": 0}, "overlapping_slots": {"maxItems": 0}}}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|(^|/|[-_.])(questions?|gold|predictions?|answers?)(/|[-_.]|$)|質問|正解|予測|回答)"}
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1, "maximum": 100000},
        "height_px": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "document_id", "file_id", "source_relative_path", "source_sha256", "origin_kind", "member_path", "member_sha256", "source_page_number", "materialized_path", "image_sha256", "dimensions"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
        "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{32}$"},
        "file_id": {"type": "string", "pattern": "^file_[0-9a-f]{32}$"},
        "source_relative_path": {"$ref": "#/$defs/safe_path"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "origin_kind": {"const": "office_embedded_image"},
        "member_path": {"$ref": "#/$defs/safe_path"},
        "member_sha256": {"$ref": "#/$defs/sha256"},
        "source_page_number": {"const": null},
        "materialized_path": {"$ref": "#/$defs/safe_path"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "dimensions": {"$ref": "#/$defs/dimensions"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "schema_version", "sample_id", "engine_page_number", "ocr_engine", "ocr_engine_fingerprint_sha256", "package_fingerprint_sha256", "layout_model_sha256", "table_model_sha256", "output_sha256", "record_integrity_sha256"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^docpoc_[0-9a-f]{24}$"},
        "schema_version": {"const": "0.2"},
        "sample_id": {"type": "string", "pattern": "^docsrc_[0-9a-f]{24}$"},
        "engine_page_number": {"const": 1},
        "ocr_engine": {"type": "string", "minLength": 1, "maxLength": 100},
        "ocr_engine_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "package_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "layout_model_sha256": {"$ref": "#/$defs/sha256"},
        "table_model_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "record_integrity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "raw_bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l", "t", "r", "b", "coord_origin"],
      "properties": {
        "l": {"type": "number", "minimum": 0, "maximum": 100000},
        "t": {"type": "number", "minimum": 0, "maximum": 100000},
        "r": {"type": "number", "minimum": 0, "maximum": 100000},
        "b": {"type": "number", "minimum": 0, "maximum": 100000},
        "coord_origin": {"enum": ["TOPLEFT", "BOTTOMLEFT"]}
      }
    },
    "cell_bbox": {
      "allOf": [
        {"$ref": "#/$defs/raw_bbox"},
        {"properties": {"coord_origin": {"const": "TOPLEFT"}}}
      ]
    },
    "provenance_bbox": {
      "allOf": [
        {"$ref": "#/$defs/raw_bbox"},
        {"properties": {"coord_origin": {"const": "BOTTOMLEFT"}}}
      ]
    },
    "derived_bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l", "t", "r", "b", "coord_origin", "derivation"],
      "properties": {
        "l": {"type": "number", "minimum": 0, "maximum": 100000},
        "t": {"type": "number", "minimum": 0, "maximum": 100000},
        "r": {"type": "number", "minimum": 0, "maximum": 100000},
        "b": {"type": "number", "minimum": 0, "maximum": 100000},
        "coord_origin": {"const": "TOPLEFT"},
        "derivation": {"const": "cell_bbox_union"}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_header", "row_header", "row_section"],
      "properties": {"column_header": {"type": "boolean"}, "row_header": {"type": "boolean"}, "row_section": {"type": "boolean"}}
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "row_start", "row_end", "column_start", "column_end", "row_span", "column_span", "roles", "raw_text", "text_status", "bbox"],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^vtcell_[0-9a-f]{24}$"},
        "row_start": {"type": "integer", "minimum": 0, "maximum": 999},
        "row_end": {"type": "integer", "minimum": 1, "maximum": 1000},
        "column_start": {"type": "integer", "minimum": 0, "maximum": 999},
        "column_end": {"type": "integer", "minimum": 1, "maximum": 1000},
        "row_span": {"type": "integer", "minimum": 1, "maximum": 1000},
        "column_span": {"type": "integer", "minimum": 1, "maximum": 1000},
        "roles": {"$ref": "#/$defs/roles"},
        "raw_text": {"type": "string", "maxLength": 100000},
        "text_status": {"const": "observed"},
        "bbox": {"$ref": "#/$defs/cell_bbox"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column"],
      "properties": {"row": {"type": "integer", "minimum": 0, "maximum": 999}, "column": {"type": "integer", "minimum": 0, "maximum": 999}}
    },
    "overlap_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "cell_ids"],
      "properties": {
        "row": {"type": "integer", "minimum": 0, "maximum": 999},
        "column": {"type": "integer", "minimum": 0, "maximum": 999},
        "cell_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^vtcell_[0-9a-f]{24}$"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_slots", "observed_slots", "coverage_ratio", "cell_count", "nonempty_cell_count", "bbox_cell_count", "missing_slots", "overlapping_slots"],
      "properties": {
        "expected_slots": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "observed_slots": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "cell_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "nonempty_cell_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "bbox_cell_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "missing_slots": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/slot"}},
        "overlapping_slots": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/overlap_slot"}}
      }
    },
    "charspan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "items": false
    },
    "raw_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bbox", "charspan", "page_number"],
      "properties": {"bbox": {"$ref": "#/$defs/provenance_bbox"}, "charspan": {"$ref": "#/$defs/charspan"}, "page_number": {"const": 1}}
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "table_index", "upstream_self_ref", "label", "rows", "columns", "bbox", "raw_provenance", "structure_status", "coverage", "cells"],
      "properties": {
        "table_id": {"type": "string", "pattern": "^vtable_[0-9a-f]{24}$"},
        "table_index": {"type": "integer", "minimum": 0, "maximum": 999},
        "upstream_self_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "rows": {"type": "integer", "minimum": 1, "maximum": 1000},
        "columns": {"type": "integer", "minimum": 1, "maximum": 1000},
        "bbox": {"$ref": "#/$defs/derived_bbox"},
        "raw_provenance": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/raw_provenance"}},
        "structure_status": {"enum": ["pass", "hold"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "cells": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "reason": {"enum": ["missing_grid_slots", "overlapping_grid_slots", "blank_cell_text", "cell_text_not_fully_verified"]},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_asset_record_sha256", "input_bundle_sha256", "table_sha256", "signature_sha256", "record_integrity_sha256"],
      "properties": {
        "visual_asset_record_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "table_sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "record_integrity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_method", "question_independent", "question_data_used", "gold_data_used", "prediction_data_used", "answer_data_used", "source_data_used", "raw_text_modified", "structure_connected", "evidence_connected", "search_unit_connected", "production_index_connected"],
      "properties": {
        "selection_method": {"const": "asset-id-and-validated-docling-image-sha-v0.1"},
        "question_independent": {"const": true},
        "question_data_used": {"const": false},
        "gold_data_used": {"const": false},
        "prediction_data_used": {"const": false},
        "answer_data_used": {"const": false},
        "source_data_used": {"const": true},
        "raw_text_modified": {"const": false},
        "structure_connected": {"const": false},
        "evidence_connected": {"const": false},
        "search_unit_connected": {"const": false},
        "production_index_connected": {"const": false}
      }
    }
  }
}
