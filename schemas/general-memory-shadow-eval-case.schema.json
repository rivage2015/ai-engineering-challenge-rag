{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/general-memory-shadow-eval-case.schema.json",
  "title": "General Memory Shadow Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "eval_case_id",
    "category",
    "query",
    "relevant_sources",
    "expected_phrases",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "general_memory_shadow_eval_case"},
    "eval_case_id": {"type": "string", "pattern": "^gm_[a-z0-9_]+$"},
    "category": {
      "enum": ["single_source", "multi_source", "temporal_conflict", "safety_exclusion"]
    },
    "query": {"type": "string", "minLength": 1},
    "relevant_sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "expected_phrases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "expected_security_disposition": {
      "enum": ["answer_eligible", "prompt_library_only", "quarantine"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reviewed", "source_locations"],
      "properties": {
        "method": {"const": "human_authored_synthetic"},
        "reviewed": {"const": true},
        "source_locations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"category": {"const": "safety_exclusion"}}},
      "then": {
        "required": ["expected_security_disposition"],
        "properties": {"relevant_sources": {"minItems": 1}}
      },
      "else": {"properties": {"relevant_sources": {"minItems": 1}}}
    }
  ]
}
