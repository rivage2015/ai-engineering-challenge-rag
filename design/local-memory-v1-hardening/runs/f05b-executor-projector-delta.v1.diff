+def _version_context_kwargs(context: dict) -> dict:
+    if not isinstance(context, dict) or set(context) not in (
+        LINEAGE_CONTEXT_FIELDS, VERSIONED_LINEAGE_CONTEXT_FIELDS, SNAPSHOT_LINEAGE_CONTEXT_FIELDS,
+    ):
