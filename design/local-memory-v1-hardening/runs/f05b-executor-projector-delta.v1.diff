+        raise ValueError("graph_lineage_validation_context_invalid")
+    if set(context) == LINEAGE_CONTEXT_FIELDS:
+        return {}
+    mode = context["version_authority_mode"]
+    if set(context) == VERSIONED_LINEAGE_CONTEXT_FIELDS and mode == "no_decisions":
+        return {"version_authority_mode": mode}
+    if set(context) != SNAPSHOT_LINEAGE_CONTEXT_FIELDS or mode != "snapshot":
+        raise ValueError("version_decision_authority_required")
+    digest = context["version_decisions_sha256"]
+    if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
+        raise ValueError("version_decision_snapshot_hash_required")
+    return {"version_authority_mode": mode,
+            "version_decisions_path": Path(context["version_decisions_path"]),
+            "version_decisions_sha256": digest}
 
 
