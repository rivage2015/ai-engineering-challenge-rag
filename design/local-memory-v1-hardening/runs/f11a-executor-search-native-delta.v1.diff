+def notebook_search_unit_contract_errors(
+    item: dict[str, Any], label: str, evidence: dict[str, dict[str, Any]],
+    documents: dict[str, dict[str, Any]],
+) -> list[str]:
+    """Evidence-bound metadata only; this does not attest original source bytes."""
+    try:
+        context = item.get("context", {})
+        if not isinstance(context, dict):
+            raise ValueError("notebook SearchUnit context must be an object")
+        sources = [evidence[key] for key in item.get("source_evidence_ids", []) if key in evidence]
+        states = [notebook_evidence_state(source, documents.get(source.get("document_id"))) for source in sources]
+        present = [state for state in states if state is not None]
+        if not present:
+            if "notebook_state" in context:
+                raise ValueError("notebook_state injected onto unrelated SearchUnit")
+            return []
+        if len(sources) != 1 or len(present) != 1:
+            raise ValueError("notebook SearchUnit must have one canonical textual source")
+        expected = present[0]
+        actual = validate_notebook_state(context.get("notebook_state"))
+        expected_type = "notebook_cell" if expected["content_origin"] == "cell_source" else "text_chunk"
+        if (canonical_json(actual) != canonical_json(expected)
+                or item.get("unit_type") != expected_type
+                or canonical_json(item.get("locator")) != canonical_json(sources[0].get("location"))):
+            raise ValueError("notebook SearchUnit metadata/type/locator differs from Evidence")
+    except ValueError as exc:
+        return [f"{label}: {exc}"]
+    return []
 
 
